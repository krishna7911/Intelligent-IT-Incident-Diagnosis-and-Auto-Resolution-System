# --- Database ---------------------------------------------------------------
# MySQL (recommended):
DATABASE_URL=mysql+pymysql://helpdesk:helpdesk@localhost:3306/helpdesk
# Zero-setup alternative for a quick demo (remove/leave DATABASE_URL empty to use SQLite):
# DATABASE_URL=

# --- App --------------------------------------------------------------------
AUTO_ASSIGN=true          # assign new tickets to the best-fit agent automatically
SEED_DEMO_DATA=true       # create sample agents + tickets on first run

# --- Optional LLM (falls back to template + RAG replies when empty) ---------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
